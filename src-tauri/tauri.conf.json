{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doTime",
  "version": "0.8.0",
  "identifier": "com.alxian.dotime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "doTime",
        "width": 1220,
        "height": 720,
        "minWidth": 1220,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": true
      },
      {
        "label": "reminder",
        "title": "doTime 提醒",

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doTime",
  "version": "0.1.0",
  "identifier": "com.alxian.dotime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "doTime",
        "width": 1060,
        "height": 720,
        "minWidth": 1060,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": true
      },
      {
        "label": "reminder",
        "title": "doTime 提醒",
        "url": "index.html?view=reminder",
        "width": 620,
        "height": 380,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
